{
  "name": "dsh-turn-bell",
  "version": "2.0.1",
  "type": "module",
  "description": "收工铃 Turn Bell — DeepSeek Harness 原生通知：一轮回答结束或需要你确认时提醒，点击直达对应会话（macOS / Windows / Linux）。Native notifications in the app's own icon and sound.",
  "author": {
    "name": "Billy王 (BillyWang)"
  },
  "license": "MIT",
  "homepage": "https://github.com/BillyWang-7/dsh-turn-bell#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BillyWang-7/dsh-turn-bell.git"
  },
  "bugs": {
    "url": "https://github.com/BillyWang-7/dsh-turn-bell/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "notifications",
    "macos",
    "productivity",
    "windows",
    "linux",
    "cross-platform"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.svg",
    "assets/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
